                "date_from": {
                    "type": "string",
                    "example": "2026-06-01"
                },
                "date_to": {
                    "type": "string",
                    "example": "2026-06-10"
                },
                "reason": {
                    "type": "string",
                    "example": "vacation"
                }
            }
